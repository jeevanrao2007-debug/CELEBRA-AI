# GEMINI_API_KEY: Optional - Required for live Gemini AI API plan generation and contextual strategist queries.
# If not provided, CelebraAI runs seamlessly using its built-in deterministic offline engines.
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server port (defaults to 3000)
PORT=3000

# NODE_ENV: production or development
NODE_ENV=production
